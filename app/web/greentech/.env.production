# Used by `npm run build` only. `npm run dev` keeps reading .env, so local work still
# talks to a locally running API.
#
# The API is served by nginx on the deployment host and proxies to the Java container on
# 9798. Do not point this at http://140.245.28.59:9798 — that port is closed at the cloud
# firewall, and a page served over HTTPS cannot call a plain-HTTP API anyway.
VITE_API_BASE_URL=https://console.jotterly.tech

# VITE_MAPBOX_TOKEN is deliberately NOT set here. Set it in the hosting platform's
# environment (Vercel, Netlify, or whatever builds this), because .env does not exist on a
# fresh clone and the maps would silently render empty without it.
