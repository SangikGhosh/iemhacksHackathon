# Local development. `npm run build` reads .env.production instead, which points at the
# deployed API.
VITE_API_BASE_URL=http://localhost:8080

# Mapbox public token (pk.*). Required for the collection-point maps in both admin consoles.
# In production set this in the hosting platform's environment, not in a committed file.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
