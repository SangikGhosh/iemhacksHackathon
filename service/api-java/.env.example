APP_PORT=8080

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=greentech
DB_USERNAME=myuser
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=20
DDL_AUTO=update

# ── JWT ──
JWT_SECRET=CHANGE_ME_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION=604800000

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Mail ──
# false = nothing sent to Resend; OTPs are printed in the app log instead.
MAIL_ENABLED=true

# ── Resend ──
RESEND_API_KEY=your-resend-api-key
RESEND_SENDER_EMAIL=noreply@jotterly.tech
RESEND_SENDER_NAME=GreenTech

# ── Detection service (Python) ──
DETECTION_BASE_URL=http://localhost:8000
DETECTION_TIMEOUT_SECONDS=45

# ── Mapbox ──
MAPBOX_TOKEN=pk.your-mapbox-public-token
MAPBOX_PROFILE=mapbox/driving

# ── Routing & rewards ──
VEHICLE_CAPACITY_KG=80
# ── Admin seeding ──
# No defaults on purpose: unset means no admin account is created.
# Do NOT use '#' in these values - it starts a comment and silently truncates the password.
ADMIN_SEED_SUPER_EMAIL=superadmin@greentech.local
ADMIN_SEED_SUPER_PASSWORD=set-a-strong-password
ADMIN_SEED_MUNICIPAL_EMAIL=hmc.admin@greentech.local
ADMIN_SEED_MUNICIPAL_PASSWORD=set-a-strong-password
ADMIN_SEED_MUNICIPAL_CODE=HMC

# ── Marketplace ──
RECYCLER_STARTING_BALANCE=10000
MARKET_FALLBACK_IMAGE=https://res.cloudinary.com/demo/image/upload/v1/samples/ecommerce/accessories-bag.jpg

COMPLETION_BONUS_POINTS=20
DOORSTEP_POINTS_PER_KG=5
DROPOFF_POINTS_PER_KG=8

# ── CORS ──
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Assistant (OpenRouter, OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
CHAT_HISTORY_TURNS=10
CHAT_MAX_TOOL_ROUNDS=4
