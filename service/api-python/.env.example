APP_PORT=8000

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-numeric-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=greentech/detections

# ── YOLO ──
YOLO_WEIGHTS=app/weights/best.pt
YOLO_FALLBACK_WEIGHTS=yolov8m.pt
YOLO_CONFIDENCE=0.30
YOLO_IOU=0.50
YOLO_IMAGE_SIZE=1280
YOLO_AGNOSTIC_NMS=true
YOLO_MAX_DETECTIONS=300
YOLO_WASTE_ONLY=true

# ── Assessment ──
MIN_TRUST_CONFIDENCE=0.35
MANUAL_PRICING_ITEMS=5
PICKUP_MIN_ITEMS=5
PICKUP_MIN_VALUE=20
PRICE_BAND=0.15
CO2_PER_TREE_YEAR_KG=21
CURRENCY=INR

# ── API ──
API_VERSION=v1
MODEL_ID=waste-detector-v1
WEIGHTS_VERSION=2026.08.08
INCLUDE_DEBUG=false

# ── CORS ──
CORS_ALLOWED_ORIGINS=*
